# k8s/01-secrets.yaml.example
# Copy to k8s/01-secrets.yaml, fill in real values, then apply.
# 01-secrets.yaml is gitignored — never commit the populated file.
#
#   cp k8s/01-secrets.yaml.example k8s/01-secrets.yaml
#   # edit values…
#   kubectl apply -f k8s/01-secrets.yaml
#
apiVersion: v1
kind: Secret
metadata:
  name: rag-secrets
  namespace: chat-llm-rag
type: Opaque
stringData:
  OPENAI_API_KEY: "sk-proj-REPLACE_ME"
---
apiVersion: v1
kind: Secret
metadata:
  name: datadog-secrets
  namespace: chat-llm-rag
type: Opaque
stringData:
  DD_API_KEY: "REPLACE_ME"
  # AI Guard needs an Application Key with the ai_guard_evaluate scope.
  DD_APP_KEY: "REPLACE_ME"
